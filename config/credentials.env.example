# 复制为 credentials.env 后填写。credentials.env 已被 gitignore。
# chmod 600 config/credentials.env
#
# 不要把真实值贴进任何 AI 对话或 transcript。
# 脚本从文件读取，我不需要看见内容。

# --- X API 应用凭据（developer.x.com 控制台） ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- OAuth 2.0 user context token（发布用，scope: tweet.read tweet.write users.read offline.access） ---
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# --- 如果你选的档位支持 bearer（只读，app context） ---
X_BEARER_TOKEN=

# --- 可选：第三方监听服务的 key（若走这条路） ---
THIRD_PARTY_PROVIDER=
THIRD_PARTY_KEY=
